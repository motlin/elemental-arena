{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// src/**/*.mdx mirrors the Storybook stories glob in .storybook/main.ts;
	// fallow's storybook plugin only detects *.stories.* files, not docs pages.
	"entry": ["src/main.{ts,tsx,js,jsx}", "src/**/*.mdx"],
	"ignorePatterns": [".storybook/**"],
	// Tooling that never appears in an import: Storybook addons and the test
	// runner are named as strings in .storybook/main.ts, eslint-plugin-storybook
	// and jiti are loaded by vite.config.ts, and @storybook/addon-docs is only
	// imported from .mdx docs pages, which fallow reads as production source.
	// lucide-react and @tanstack/react-query-devtools are genuinely unused and
	// should come off this list by being uninstalled, not ignored.
	"ignoreDependencies": [
		"@chromatic-com/storybook",
		"@sentry/vite-plugin",
		"@storybook/addon-a11y",
		"@storybook/addon-docs",
		"@storybook/addon-onboarding",
		"@storybook/addon-vitest",
		"@storybook/test-runner",
		"@tanstack/react-query-devtools",
		"eslint-plugin-storybook",
		"jiti",
		"lucide-react",
	],
	"rules": {
		"unused-dependencies": "warn",
	},
}
