{
	"name": "elemental-arena",
	"version": "0.0.0",
	"description": "A hot-seat tactical card game played on a grid of fusing elemental terrain",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"check": "vp check",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
		"multiplayer": "wrangler dev",
		"multiplayer:check": "node scripts/multiplayer-smoke.mjs",
		"multiplayer:online": "node scripts/online-smoke.mjs",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies": {
		"agentation": "^3.0.2",
		"lucide-react": "^1.31.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.0",
		"@cloudflare/workers-types": "^5.20260825.1",
		"@storybook/addon-a11y": "^10.5.8",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/addon-vitest": "^10.5.7",
		"@storybook/react-vite": "^10.5.7",
		"@storybook/test-runner": "^0.24.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@testing-library/react": "^16.3.2",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.1",
		"eslint-plugin-storybook": "^10.5.8",
		"fallow": "^3.16.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.2",
		"playwright": "^1.62.1",
		"storybook": "^10.5.8",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.123.0"
	},
	"packageManager": "pnpm@11.1.1"
}
