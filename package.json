{
  "name": "elemental-arena",
  "version": "0.0.0",
  "description": "A hot-seat tactical card game played on a grid of fusing elemental terrain",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vp dev",
    "preview": "vp preview",
    "check": "vp check",
    "build": "vp build",
    "oxlint": "vp lint . --fix",
    "oxlint:ci": "vp lint . --format github",
    "fmt": "vp fmt",
    "fmt:ci": "vp fmt --check",
    "fallow": "fallow fix --yes",
    "fallow:ci": "fallow dead-code",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/vitest/dist/cli.js",
    "test:ui": "node node_modules/vitest/dist/cli.js --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
    "multiplayer": "wrangler dev",
    "multiplayer:check": "node scripts/multiplayer-smoke.mjs",
    "multiplayer:online": "node scripts/online-smoke.mjs",
    "prepare": "VITE_GIT_HOOKS=0 vp config"
  },
  "dependencies": {
    "agentation": "^3.1.2",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@storybook/test-runner": "^0.24.4",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "wrangler": "^4.151.2",
    "eslint-plugin-storybook": "^10.6.3",
    "fallow": "^3.33.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
